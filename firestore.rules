rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 친구 코드(groups/{코드}) 안에서만 읽고 쓸 수 있습니다.
    match /groups/{group}/players/{uid} {
      allow read: if request.auth != null;
      // 자기 기록만 쓸 수 있음
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.level is int && request.resource.data.species is int
        && request.resource.data.xp is int && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9a-fA-F]{3,8}$');
    }
    // 친구에게 보내는 우편: 선물, 텃밭 물 주기, 방문 쪽지, 같이 걷기 초대
    match /groups/{group}/mail/{id} {
      allow read: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.kind in ['gift', 'water', 'visit', 'walk']
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 12
        && (!('n' in request.resource.data) || (request.resource.data.n is int
          && request.resource.data.n >= 1 && request.resource.data.n <= 10));
      // 받은 사람만 지울 수 있음 (받기를 누르면 지워짐)
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    match /groups/{group}/feed/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 12;
    }
  }
}
